# Remote flavor settings. Read by app/build.gradle. Do not commit this file.

# Public address of the remote command server (Cloudflare Tunnel).
BRIDGE_URL=wss://gshock-remote.avmedia.org
# BRIDGE_URL=wss://localhost:9998

# Shared secret for the remote server. Must match GSHOCK_REMOTE_TOKEN in ~/remote/server.env on the pihole.
GSHOCK_REMOTE_TOKEN=8e13299e14f2d4a9ee21a54f81a8155d0895dbbc9db1374d3f954e4170a1d202

# Cloudflare Access service token. Leave empty unless Access is enabled.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

